  "triggers": [
    {
      "name": "events_no_update",
      "sql": "CREATE TRIGGER events_no_update BEFORE UPDATE ON events\r\nBEGIN SELECT RAISE(ABORT,'events are immutable'); END"
    },
    {
      "name": "events_no_delete",
      "sql": "CREATE TRIGGER events_no_delete BEFORE DELETE ON events\r\nBEGIN SELECT RAISE(ABORT,'events are immutable'); END"
    },
    {
      "name": "events_no_replace",
      "sql": "CREATE TRIGGER events_no_replace BEFORE INSERT ON events\r\nWHEN EXISTS(SELECT 1 FROM events WHERE event_id=NEW.event_id OR seq=NEW.seq)\r\nBEGIN SELECT RAISE(ABORT,'events are immutable'); END"
    }
