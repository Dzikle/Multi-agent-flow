# Generate two unique secrets of at least 16 chars each (never commit actual values).
LEDGER_DISPATCHER_TOKEN=replace-with-unique-dispatcher-secret
LEDGER_READ_TOKEN=replace-with-unique-read-secret
LEDGER_DB_PATH=./data/ledger.db
LEDGER_ARTIFACT_DIR=./data/artifacts
HOST=127.0.0.1
PORT=4177
LEDGER_HEARTBEAT_TTL_MS=120000
LEDGER_MAX_ARTIFACT_BYTES=10485760
# Uploads off by default until redaction/privacy verification.
LEDGER_ALLOW_ARTIFACT_UPLOAD=false
